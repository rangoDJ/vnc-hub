#!/command/with-contenv bash

echo "[s6-init] Starting Selkies RDP WebUI & Session Manager..."

export PYTHONUNBUFFERED=1
export DISPLAY=${DISPLAY:-:1}
export CONFIG_DIR=${CONFIG_DIR:-/config}
export SHARED_DIR=${SHARED_DIR:-/shared}
export FRONTEND_DIR=${FRONTEND_DIR:-/app/frontend}
# PulseAudio runs as abc on its native socket under XDG_RUNTIME_DIR; only override if explicitly set
if [ -n "${PULSE_SERVER}" ]; then
    export PULSE_SERVER
fi

# Files created by earlier root-run versions must be writable by abc
mkdir -p "${CONFIG_DIR}" "${SHARED_DIR}"
lsiown abc:abc "${CONFIG_DIR}" "${SHARED_DIR}"
for f in "${CONFIG_DIR}/profiles.json" "${CONFIG_DIR}/.session_secret"; do
    if [ -e "$f" ]; then
        lsiown abc:abc "$f"
        chmod 600 "$f"
    fi
done

cd /app/backend

exec s6-setuidgid abc /app/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --log-level info
